# Obligatoria: clave de la API de Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Opcional: modelo que LEE LOS VÍDEOS y extrae los lugares (por defecto claude-sonnet-5).
# No lo bajes a un modelo pequeño: leer los carteles de pantalla es lo que hace la app.
ANTHROPIC_MODEL=claude-sonnet-5

# Opcional: modelo para planificar viajes y sugerir actividades, que es texto normal
# (por defecto claude-haiku-4-5-20251001, la mitad de coste)
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Recomendada: imágenes de satélite nítidas al hacer zoom. Token PÚBLICO (pk.…) de Mapbox,
# restringido a tu dominio. Se lee al compilar: redespliega tras cambiarlo.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Opcional: transcribe el audio del vídeo cuando TikTok no trae subtítulos (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Opcional: afina las coordenadas con el geocodificador de Mapbox (https://account.mapbox.com/access-tokens/)
MAPBOX_TOKEN=

# Opcional: análisis máximos por visitante cada 10 minutos (por defecto 10)
RATE_LIMIT_PER_10_MIN=10

# Opcional: servicio para leer TikTok (misma respuesta JSON que tikwm)
# TIKTOK_RESOLVER_URL=https://www.tikwm.com/api/?hd=0&url=
